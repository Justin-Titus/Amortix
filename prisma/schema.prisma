generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                 String              @id
  name               String?
  email              String              @unique
  emailVerified      DateTime?
  password           String?
  image              String?
  onboardingStep     Int                 @default(0)
  onboardingCompleted Boolean            @default(false)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  loans              Loan[]
  chatSessions       ChatSession[]
  healthSnapshots    HealthSnapshot[]
  financialProfile   FinancialProfile?
  rateLimits         RateLimit[]
  notifications      Notification[]
  emailNotifications Boolean             @default(true)
  pushNotifications  Boolean             @default(true)
  expoPushToken      String?
  workspaces         WorkspaceMember[]
  consentRecords     ConsentRecord[]
}

model FinancialProfile {
  id                 String         @id @default(cuid())
  userId             String         @unique
  monthlyIncome      Float
  monthlyExpenses    Float
  creditScoreRange   String
  employmentType     EmploymentType
  hasEmergencyFund   Boolean        @default(false)
  emergencyFundMonths Int           @default(0)
  affordabilityScore Int?
  currency           String         @default("INR")
  updatedAt          DateTime       @updatedAt
  user               User           @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Loan {
  id                 String          @id @default(cuid())
  userId             String
  name               String
  loanType           LoanType
  principal          Float
  outstandingBalance Float
  interestRate       Float
  rateType           RateType
  tenureMonths       Int
  emiAmount          Float
  startDate          DateTime
  nextEmiDate        DateTime?
  lender             String?
  notes              String?
  currency           String          @default("INR")
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  user               User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  repaymentPlans     RepaymentPlan[]
  payments           Payment[]
  workspaceId        String?
  workspace          Workspace?      @relation(fields: [workspaceId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([workspaceId])
}

model Payment {
  id          String      @id @default(cuid())
  loanId      String
  amount      Float
  paymentDate DateTime
  type        PaymentType @default(EMI)
  notes       String?
  createdAt   DateTime    @default(now())
  loan        Loan        @relation(fields: [loanId], references: [id], onDelete: Cascade)

  @@index([loanId])
}

enum PaymentType {
  EMI
  PREPAYMENT
}


model RepaymentPlan {
  id            String   @id @default(cuid())
  loanId        String
  strategy      Strategy
  extraPayment  Float    @default(0)
  totalInterest Float
  payoffDate    DateTime
  monthlySaved  Float
  schedule      Json
  createdAt     DateTime @default(now())
  loan          Loan     @relation(fields: [loanId], references: [id], onDelete: Cascade)

  @@index([loanId])
}

model ChatSession {
  id        String   @id @default(cuid())
  userId    String
  title     String?
  messages  Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model RateLimit {
  id          String   @id @default(cuid())
  userId      String
  endpoint    String
  count       Int      @default(0)
  windowStart DateTime
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, endpoint, windowStart])
}

model HealthSnapshot {
  id                 String   @id @default(cuid())
  userId             String
  capturedAt         DateTime @default(now())
  affordabilityScore Int
  dtiRatio           Float
  emiToIncomeRatio   Float
  totalOutstanding   Float
  totalEMI           Float
  activeLoans        Int
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, capturedAt])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  body      String
  type      String
  link      String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead, createdAt])
}

enum LoanType {
  HOME
  EDUCATION
  PERSONAL
  VEHICLE
  BUSINESS
  GOLD
  OTHER
}

enum RateType {
  FIXED
  FLOATING
}

enum Strategy {
  AVALANCHE
  SNOWBALL
  HYBRID
  CUSTOM
}

enum EmploymentType {
  SALARIED
  SELF_EMPLOYED
  STUDENT
  BUSINESS_OWNER
  OTHER
}

model Workspace {
  id          String            @id @default(cuid())
  name        String
  createdBy   String
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  members     WorkspaceMember[]
  invites     WorkspaceInvite[]
  loans       Loan[]
}

model WorkspaceMember {
  id          String        @id @default(cuid())
  workspaceId String
  userId      String
  role        WorkspaceRole @default(MEMBER)
  joinedAt    DateTime      @default(now())
  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId])
}

model WorkspaceInvite {
  id          String        @id @default(cuid())
  workspaceId String
  email       String
  role        WorkspaceRole @default(MEMBER)
  status      InviteStatus  @default(PENDING)
  invitedBy   String
  createdAt   DateTime      @default(now())
  expiresAt   DateTime
  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([email, status])
  @@index([workspaceId])
}

enum WorkspaceRole {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

enum InviteStatus {
  PENDING
  ACCEPTED
  DECLINED
  EXPIRED
}

model ConsentRecord {
  id          String   @id @default(cuid())
  userId      String
  purpose     String   // "service_terms" | "marketing_emails" | "analytics" | "functional"
  granted     Boolean
  grantedAt   DateTime @default(now())
  ipHash      String?  // Anonymized hash of IP for audit trail
  userAgent   String?
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
}

model DataRightsRequest {
  id          String   @id @default(cuid())
  userId      String?
  name        String
  email       String
  requestType String   // "ACCESS" | "CORRECTION" | "ERASURE" | "WITHDRAW" | "PORTABILITY"
  details     String?
  status      String   @default("PENDING") // "PENDING" | "IN_PROGRESS" | "COMPLETED"
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([email, status])
}

