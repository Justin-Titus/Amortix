generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                 String              @id @default(cuid())
  name               String?
  email              String              @unique
  emailVerified      DateTime?
  password           String?
  image              String?
  onboardingStep     Int                 @default(0)
  onboardingCompleted Boolean            @default(false)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  accounts           Account[]
  sessions           Session[]
  loans              Loan[]
  chatSessions       ChatSession[]
  healthSnapshots    HealthSnapshot[]
  financialProfile   FinancialProfile?
  rateLimits         RateLimit[]
  verificationTokens VerificationToken[]
  notifications      Notification[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  id      String    @id @default(cuid())
  userId  String?
  token   String    @unique
  type    TokenType
  expires DateTime
  user    User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model FinancialProfile {
  id                 String         @id @default(cuid())
  userId             String         @unique
  monthlyIncome      Float
  monthlyExpenses    Float
  creditScoreRange   String
  employmentType     EmploymentType
  hasEmergencyFund   Boolean        @default(false)
  emergencyFundMonths Int           @default(0)
  affordabilityScore Int?
  updatedAt          DateTime       @updatedAt
  user               User           @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Loan {
  id                 String          @id @default(cuid())
  userId             String
  name               String
  loanType           LoanType
  principal          Float
  outstandingBalance Float
  interestRate       Float
  rateType           RateType
  tenureMonths       Int
  emiAmount          Float
  startDate          DateTime
  nextEmiDate        DateTime?
  lender             String?
  notes              String?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  user               User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  repaymentPlans     RepaymentPlan[]
  payments           Payment[]
}

model Payment {
  id          String      @id @default(cuid())
  loanId      String
  amount      Float
  paymentDate DateTime
  type        PaymentType @default(EMI)
  notes       String?
  createdAt   DateTime    @default(now())
  loan        Loan        @relation(fields: [loanId], references: [id], onDelete: Cascade)
}

enum PaymentType {
  EMI
  PREPAYMENT
}


model RepaymentPlan {
  id            String   @id @default(cuid())
  loanId        String
  strategy      Strategy
  extraPayment  Float    @default(0)
  totalInterest Float
  payoffDate    DateTime
  monthlySaved  Float
  schedule      Json
  createdAt     DateTime @default(now())
  loan          Loan     @relation(fields: [loanId], references: [id], onDelete: Cascade)
}

model ChatSession {
  id        String   @id @default(cuid())
  userId    String
  title     String?
  messages  Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model RateLimit {
  id          String   @id @default(cuid())
  userId      String
  endpoint    String
  count       Int      @default(0)
  windowStart DateTime
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, endpoint, windowStart])
}

model HealthSnapshot {
  id                 String   @id @default(cuid())
  userId             String
  capturedAt         DateTime @default(now())
  affordabilityScore Int
  dtiRatio           Float
  emiToIncomeRatio   Float
  totalOutstanding   Float
  totalEMI           Float
  activeLoans        Int
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, capturedAt])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  body      String
  type      String
  link      String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead, createdAt])
}

enum LoanType {
  HOME
  EDUCATION
  PERSONAL
  VEHICLE
  BUSINESS
  GOLD
  OTHER
}

enum RateType {
  FIXED
  FLOATING
}

enum Strategy {
  AVALANCHE
  SNOWBALL
  HYBRID
  CUSTOM
}

enum EmploymentType {
  SALARIED
  SELF_EMPLOYED
  STUDENT
  BUSINESS_OWNER
  OTHER
}

enum TokenType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}
